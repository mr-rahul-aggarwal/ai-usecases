# Required: OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Set this to the endpoint associated with your API key. For OpenAI, use https://api.openai.com/v1.
OPENAI_BASE_URL=https://aibe.mygreatlearning.com/openai/v1

# Model Configuration
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=insurance_policies

# Data Paths
POLICY_PDF_PATH=./data/policy.pdf
COVERAGE_CSV_PATH=./data/coverage_data.csv
